{
  "version": 1,
  "project": "zen-dive-manila",
  "goal": "./scripts/verify.sh が PASS し、ブラウザで index.html を開いた時に console error 0、チャットウィジェットが /api/chat から応答を返すこと。見た目/配線の修正では、これは『ローカルで正しい』の完了条件であって『ユーザーに見える』の完了条件ではない — 後者は ./scripts/check-live.sh が in sync を返すまで満たされない",
  "verify": {
    "commands": [
      { "name": "syntax", "run": "node --check api/chat.js && node --check js/chat.js && node --check js/main.js", "required": true },
      { "name": "smoke", "run": "bash scripts/verify.sh", "required": true },
      { "name": "self-test", "run": "bash scripts/self-test.sh", "required": true },
      { "name": "live-sync", "run": "bash scripts/check-live.sh", "required": false },
      { "name": "visual-prod", "run": "TARGET_URL=https://zen-dive-manila.vercel.app npx playwright test", "required": false }
    ]
  },
  "limits": {
    "maxIterations": 5,
    "maxWallClockMin": 20,
    "sameFailureStreak": 2
  },
  "irreversible": [
    "git push",
    "gh pr merge",
    "vercel --prod",
    "vercel deploy --prod",
    "vercel env rm",
    "rm -rf"
  ],
  "protected": [
    "scripts/verify.sh",
    "scripts/check-live.sh",
    "scripts/self-test.sh",
    ".claude/loop/harness.json",
    "api/system-prompt.txt",
    "tests/**",
    "playwright.config.mjs",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "worktree": {
    "strategy": "branch",
    "prefix": "loop/"
  },
  "observer": {
    "everyNMutations": 12
  }
}
